# ============================================================
# Akasha - Global Git Ignore
# ============================================================


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so

# Virtual environments
.venv/
backend/venv/
venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / type checking
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Python version configuration
.python-version


# ------------------------------------------------------------
# Node / React / Frontend
# ------------------------------------------------------------

node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/build/

# Vite
frontend/.vite/

# Next.js
.next/
out/


# ------------------------------------------------------------
# Environment / Secrets / Local Configuration
# ------------------------------------------------------------

.env
.env.*
!.env.example
*.local
*.secret
secrets/
local/
config.local.*
settings.local.*

# Firebase / Google credentials
serviceAccountKey.json
firebase-service-account.json
google-credentials.json
*.pem
*.key


# ------------------------------------------------------------
# Model Weights & Machine Learning Artifacts
# ------------------------------------------------------------

# PyTorch
*.pt
*.pth
*.ckpt
*.bin

# Hugging Face / Transformers
*.safetensors
*.safetensors.index.json

# TensorFlow
*.h5
*.hdf5
*.pb

# ONNX
*.onnx
*.onnx_data

# Other model formats
*.gguf
*.ggml

# LoRA / PEFT adapters
adapter_model.*
adapter_config.json

# Model checkpoints / training output
checkpoints/
checkpoint-*/
runs/
wandb/
mlruns/


# ------------------------------------------------------------
# Caches & Datasets
# ------------------------------------------------------------

.huggingface/
hf_cache/
transformers_cache/
.cache/

# Datasets downloaded locally
datasets/
data/
data/raw/
data/processed/

# NOTE:
# If we later have small datasets that MUST be versioned,
# use ! rules for those specific files/directories.


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ------------------------------------------------------------
# Docker & Terraform
# ------------------------------------------------------------

.docker/
docker-compose.override.yml

.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl


# ------------------------------------------------------------
# Firebase
# ------------------------------------------------------------

.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
firestore-debug.*.log
ui-debug.log
ui-debug.*.log


# ------------------------------------------------------------
# IDEs / Editors / OS Junk
# ------------------------------------------------------------

.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.swn
*~

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
.fuse_hidden*


# ------------------------------------------------------------
# Temporary Files & Artifacts
# ------------------------------------------------------------

tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Generated documentation / artifacts
*.pdf
*.zip
*.tar
*.tar.gz

# Generated visualizations
outputs/
results/


# ------------------------------------------------------------
# OS / GPU / Profiling Output
# ------------------------------------------------------------

*.prof
*.nsys-rep
*.ncu-rep
*.nvvp