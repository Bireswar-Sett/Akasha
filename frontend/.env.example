# ============================================================
# AKASHA Frontend — Environment Variables
# ============================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env to source control.
# ============================================================


# ────────────────────────────────────────────────────────────
# Backend API
# ────────────────────────────────────────────────────────────
# Full base URL of the FastAPI backend.
# Local dev: leave empty (Vite proxy handles /api → localhost:8000)
# Production: set to your ECS service URL.
VITE_API_BASE_URL=


# ────────────────────────────────────────────────────────────
# AWS Cognito
# ────────────────────────────────────────────────────────────
VITE_COGNITO_USER_POOL_ID=eu-north-1_R71nMtdeZ
VITE_COGNITO_CLIENT_ID=2dj154bemrmeifpl2n6aob10ck
VITE_COGNITO_DOMAIN=eu-north-1r71nmtdez.auth.eu-north-1.amazoncognito.com

# Comma-separated list of allowed OAuth redirect URLs.
# Leave empty to use the built-in defaults (localhost + Amplify + Firebase Hosting).
VITE_COGNITO_REDIRECT_URLS=


# ────────────────────────────────────────────────────────────
# Firebase (optional — legacy Firestore session storage)
# ────────────────────────────────────────────────────────────
# Firebase Auth is no longer used. These vars are retained only for
# Firestore (if still used for session persistence). Leave empty if
# sessions are stored in localStorage only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to force the demo / sandbox mode (no real API calls).
VITE_DEMO_MODE=false
